generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== MODELS ====================

enum UserRole {
  ADMIN
  USER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  PAID
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  phone         String?
  role          UserRole  @default(USER)
  avatar        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bookings      Booking[]
  payments      Payment[]
  testimonials  Testimonial[]
  chatMessages  ChatMessage[]
  notifications Notification[]

  @@map("users")
}

model Package {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Int
  features    String
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings    Booking[]

  @@map("packages")
}

model Vendor {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String?
  price       Int?
  contact     String?
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookingVendors BookingVendor[]

  @@map("vendors")
}

model Booking {
  id            String        @id @default(cuid())
  userId        String
  packageId     String
  status        BookingStatus @default(PENDING)
  weddingDate   DateTime
  venue         String
  theme         String?
  guestCount    Int
  notes         String?
  totalPrice    Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id])
  package       Package       @relation(fields: [packageId], references: [id])
  bookingDetails BookingDetail?
  payments      Payment[]
  vendors       BookingVendor[]
  timelines     Timeline[]
  chatMessages  ChatMessage[]
  gallery       Gallery[]
  testimonial   Testimonial?

  @@map("bookings")
}

model BookingDetail {
  id            String   @id @default(cuid())
  bookingId     String   @unique
  groomName     String
  brideName     String
  groomPhone    String
  bridePhone    String
  venueAddress  String
  ceremonyType  String
  additionalNotes String?

  booking       Booking  @relation(fields: [bookingId], references: [id])

  @@map("booking_details")
}

model BookingVendor {
  id          String   @id @default(cuid())
  bookingId   String
  vendorId    String
  notes       String?

  booking     Booking  @relation(fields: [bookingId], references: [id])
  vendor      Vendor   @relation(fields: [vendorId], references: [id])

  @@map("booking_vendors")
}

model Payment {
  id              String        @id @default(cuid())
  bookingId       String
  userId          String        // <- TAMBAHKAN INI
  amount          Int
  paymentMethod   String?
  midtransOrderId String?
  midtransSnapUrl String?
  proofImage      String?
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  booking         Booking       @relation(fields: [bookingId], references: [id])
  user            User          @relation(fields: [userId], references: [id]) // <- TAMBAHKAN INI

  @@map("payments")
}

model Timeline {
  id          String   @id @default(cuid())
  bookingId   String
  title       String
  description String?
  eventTime   DateTime
  isCompleted Boolean  @default(false)

  booking     Booking  @relation(fields: [bookingId], references: [id])

  @@map("timelines")
}

model Gallery {
  id          String   @id @default(cuid())
  bookingId   String?
  image       String
  caption     String?
  uploadedBy  String
  createdAt   DateTime @default(now())

  booking     Booking? @relation(fields: [bookingId], references: [id])

  @@map("galleries")
}

model Testimonial {
  id           String   @id @default(cuid())
  userId       String
  bookingId    String   @unique
  content      String
  rating       Int
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id])
  booking      Booking  @relation(fields: [bookingId], references: [id])

  @@map("testimonials")
}

model ChatMessage {
  id          String   @id @default(cuid())
  bookingId   String
  senderId    String
  message     String
  createdAt   DateTime @default(now())

  booking     Booking  @relation(fields: [bookingId], references: [id])
  sender      User     @relation(fields: [senderId], references: [id])

  @@map("chat_messages")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@map("notifications")
}