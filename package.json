{
  "name": "wedding-organizer-firestore",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run build",
    "admin:set": "node --env-file=.env.local scripts/set-admin.mjs",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "migrate:legacy": "node --env-file=.env.local migration/import-legacy-json.mjs",
    "migrate:media": "node --env-file=.env.local migration/migrate-media-to-cloudinary.mjs"
  },
  "dependencies": {
    "cloudinary": "^2.0.0",
    "firebase": "^12.0.0",
    "firebase-admin": "14.4.0",
    "lucide-react": "^1.14.0",
    "midtrans-client": "^1.4.3",
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.5",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
