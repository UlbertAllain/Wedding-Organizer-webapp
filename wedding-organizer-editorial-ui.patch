+  background: var(--surface);
+}
+
+.auth-visual {
+  position: relative;
+  min-height: 100vh;
+  overflow: hidden;
+  color: #fff;
+  background: var(--forest-deep);
+}
+
+.auth-visual-photo,
+.auth-visual-overlay {
+  position: absolute;
+  inset: 0;
+}
+
+.auth-visual-photo {
+  background-image: url("https://images.unsplash.com/photo-1750735698449-6444e0424cbd?auto=format&fit=crop&w=1600&q=82");
+  background-position: center;
+  background-size: cover;
+  transform: scale(1.02);
+}
+
+.auth-visual-overlay {
+  background: linear-gradient(180deg, rgba(13, 23, 17, 0.18), rgba(13, 23, 17, 0.88));
+}
+
+.auth-back-link {
+  position: absolute;
+  z-index: 2;
+  top: 34px;
+  left: 38px;
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  padding-bottom: 4px;
+  border-bottom: 1px solid rgba(255, 255, 255, 0.5);
+  font-size: 0.78rem;
+  font-weight: 650;
+}
+
+.auth-visual-copy {
+  position: absolute;
+  z-index: 2;
+  right: 9%;
+  bottom: 8%;
+  left: 9%;
+  max-width: 620px;
+}
+
