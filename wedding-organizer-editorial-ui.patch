+}
+
+.compact-record-list > a > div {
+  min-width: 0;
+  display: grid;
+  gap: 3px;
+}
+
+.compact-record-list strong {
+  font-size: 0.84rem;
+}
+
+.compact-record-list div > span {
+  overflow: hidden;
+  color: var(--ink-muted);
+  font-size: 0.7rem;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
