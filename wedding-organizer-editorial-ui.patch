+  width: 100%;
+  height: 50px;
+  padding: 0 14px;
+  color: var(--ink);
+  background: transparent;
+  border: 1px solid var(--line-strong);
+  border-radius: var(--radius-sm);
+  outline: 0;
+  transition: border-color 150ms ease, box-shadow 150ms ease;
+}
+
+.auth-card input:focus {
+  border-color: var(--forest);
+  box-shadow: 0 0 0 3px rgba(36, 55, 46, 0.08);
+}
+
+.auth-card input::placeholder {
+  color: #a7aaa5;
+}
+
+.auth-field-grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 14px;
+}
+
+.auth-reset {
+  width: fit-content;
+  padding: 0 0 3px;
+  color: var(--ink-soft);
+  background: transparent;
+  border-bottom: 1px solid var(--line-strong);
+  font-size: 0.78rem;
+}
+
+.auth-switch {
+  padding-top: 6px;
+  color: var(--ink-muted);
+  font-size: 0.82rem;
+  text-align: center;
+}
+
+.auth-switch a {
+  color: var(--ink);
+  font-weight: 700;
+}
+
+.auth-privacy-note {
+  margin-top: 48px;
+  color: var(--ink-muted);
+  font-size: 0.7rem;
+  line-height: 1.6;
+  text-align: center;
+}
+
+@media (max-width: 980px) {
+  .auth-layout {
+    grid-template-columns: 0.82fr 1.18fr;
+  }
+
+  .auth-visual-copy ol {
+    grid-template-columns: 1fr;
+    gap: 12px;
+  }
+
+  .auth-visual-copy li {
+    grid-template-columns: 28px 1fr;
+  }
+}
+
+@media (max-width: 760px) {
+  .auth-layout {
+    display: block;
+  }
+
+  .auth-visual {
+    min-height: 360px;
+  }
+
+  .auth-visual-copy {
+    bottom: 34px;
+  }
+
+  .auth-visual-copy h2 {
+    max-width: 520px;
+    font-size: clamp(2.5rem, 11vw, 4rem);
+  }
+
+  .auth-visual-copy ol {
+    display: none;
+  }
+
+  .auth-form-panel {
+    min-height: 0;
+    padding: 50px 24px 64px;
+  }
+
+  .auth-wordmark {
+    margin-bottom: 44px;
+  }
+}
+
+@media (max-width: 520px) {
+  .auth-visual {
+    min-height: 320px;
+  }
+
+  .auth-back-link {
+    top: 24px;
+    left: 24px;
+  }
+
+  .auth-visual-copy {
+    right: 24px;
+    left: 24px;
+  }
+
+  .auth-field-grid {
+    grid-template-columns: 1fr;
+  }
+}
diff --git a/src/styles/base.css b/src/styles/base.css
new file mode 100644
index 0000000..a84aebb
--- /dev/null
+++ b/src/styles/base.css
@@ -0,0 +1,292 @@
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+html {
+  scroll-behavior: smooth;
+}
+
+body {
+  margin: 0;
+  color: var(--ink);
+  background: var(--paper);
+  font-family: var(--font-sans);
+  font-size: 15px;
+  line-height: 1.6;
+  text-rendering: optimizeLegibility;
+  -webkit-font-smoothing: antialiased;
+}
+
+body,
+button,
+input,
+textarea,
+select {
+  font: inherit;
+}
+
+a {
+  color: inherit;
+  text-decoration: none;
+}
+
+button,
+input,
+textarea,
+select {
+  border: 0;
+}
+
+button,
+select {
+  cursor: pointer;
+}
+
+img {
+  display: block;
+  max-width: 100%;
+}
+
+h1,
+h2,
+h3,
+p,
+dl,
+dd,
+blockquote,
+figure {
+  margin: 0;
+}
+
+ul,
+ol {
+  margin: 0;
+  padding: 0;
+}
+
+button:focus-visible,
+a:focus-visible,
+input:focus-visible,
+textarea:focus-visible,
+select:focus-visible {
+  outline: 3px solid rgba(164, 95, 76, 0.28);
+  outline-offset: 2px;
+}
+
+::selection {
+  color: #fff;
+  background: var(--forest);
+}
+
+.section-label,
+.eyebrow {
+  color: var(--clay);
+  font-size: 0.72rem;
+  font-weight: 700;
+  letter-spacing: 0.16em;
+  line-height: 1.3;
+  text-transform: uppercase;
+}
+
+.section-label-light,
+.eyebrow.light {
+  color: rgba(255, 255, 255, 0.68);
+}
+
+.button {
+  min-height: 42px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 10px;
+  padding: 0 18px;
+  border: 1px solid transparent;
+  border-radius: var(--radius-sm);
+  font-size: 0.88rem;
+  font-weight: 650;
+  line-height: 1;
+  transition: background 160ms ease, border-color 160ms ease, color 160ms ease,
+    transform 160ms ease;
+}
+
+.button:hover:not(:disabled) {
+  transform: translateY(-1px);
+}
+
+.button:disabled {
+  cursor: not-allowed;
+  opacity: 0.58;
+}
+
+.button-dark,
+.button.primary {
+  color: #fff;
+  background: var(--forest);
+  border-color: var(--forest);
+}
+
+.button-dark:hover:not(:disabled),
+.button.primary:hover:not(:disabled) {
+  background: var(--forest-deep);
+  border-color: var(--forest-deep);
+}
+
+.button-light,
+.light-button {
+  color: var(--forest-deep);
+  background: #fff;
+  border-color: #fff;
+}
+
+.button-outline,
+.button.secondary {
+  color: var(--ink);
+  background: transparent;
+  border-color: var(--line-strong);
+}
+
+.button-outline:hover:not(:disabled),
+.button.secondary:hover:not(:disabled) {
+  background: var(--surface-soft);
+  border-color: var(--ink-muted);
+}
+
+.button-quiet,
+.button.ghost {
+  min-height: 38px;
+  padding-inline: 12px;
+  color: var(--ink);
+  background: transparent;
+}
+
+.button-danger,
+.button.danger {
+  color: var(--danger);
+  background: transparent;
+  border-color: rgba(154, 73, 63, 0.38);
+}
+
+.button-danger:hover:not(:disabled),
+.button.danger:hover:not(:disabled) {
+  background: var(--danger-soft);
+}
+
+.button-large {
+  min-height: 50px;
+  padding-inline: 22px;
+}
+
+.button.small {
+  min-height: 34px;
+  padding-inline: 12px;
+  font-size: 0.78rem;
+}
+
+.button-full,
+.button.full {
+  width: 100%;
+}
+
+.inline-link,
+.text-link {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  color: var(--ink);
+  border-bottom: 1px solid var(--ink);
+  font-size: 0.87rem;
+  font-weight: 650;
+  line-height: 1.8;
+}
+
+.inline-link-light {
+  color: #fff;
+  border-color: rgba(255, 255, 255, 0.56);
+}
+
+.alert {
+  padding: 12px 14px;
+  color: var(--success);
+  background: var(--success-soft);
+  border: 1px solid rgba(53, 101, 74, 0.18);
+  border-radius: var(--radius-sm);
+  font-size: 0.86rem;
+}
+
+.alert.error {
+  color: var(--danger);
+  background: var(--danger-soft);
+  border-color: rgba(154, 73, 63, 0.2);
+}
+
+.muted {
+  color: var(--ink-muted);
+}
+
+.row {
+  display: flex;
+  align-items: center;
+}
+
+.gap {
+  gap: 8px;
+}
+
+.wrap {
+  flex-wrap: wrap;
+}
+
+.badge {
+  width: fit-content;
+  display: inline-flex;
+  align-items: center;
+  min-height: 26px;
+  padding: 3px 9px;
+  border-radius: 999px;
+  font-size: 0.68rem;
+  font-weight: 720;
+  letter-spacing: 0.04em;
+  line-height: 1.2;
+  white-space: nowrap;
+}
+
+.badge.pending {
+  color: var(--warning);
+  background: var(--warning-soft);
+}
+
+.badge.confirmed,
+.badge.paid,
+.badge.completed {
+  color: var(--success);
+  background: var(--success-soft);
+}
+
+.badge.in_progress {
+  color: var(--info);
+  background: var(--info-soft);
+}
+
+.badge.rejected,
+.badge.cancelled,
+.badge.failed {
+  color: var(--danger);
+  background: var(--danger-soft);
+}
+
+.badge.refunded {
+  color: var(--ink-soft);
+  background: var(--surface-soft);
+}
+
+@media (max-width: 720px) {
+  body {
+    font-size: 14px;
+  }
+
+  .button-large {
+    min-height: 46px;
+  }
+}
diff --git a/src/styles/dashboard.css b/src/styles/dashboard.css
new file mode 100644
index 0000000..9666791
